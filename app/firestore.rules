rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if requester is the admin
    function isAdmin() {
      return request.auth != null &&
        request.auth.token.email == 'okohwiz889@mail.com';
    }

    // Shared international transfer destinations. Only the administrator can add entries.
    match /transfer_countries/{countryId} {
      allow read: if request.auth != null;
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'created_at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 80
        && request.resource.data.created_at == request.time;
      allow update, delete: if false;
    }

    // Profiles
    match /profiles_nbb/{userId} {
      // Admin can read/write all profiles
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == userId);
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email;
      // Email changes must use the admin API so Firebase Auth stays in sync.
      allow update: if (isAdmin() || (request.auth != null && request.auth.uid == userId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']);
      allow delete: if isAdmin();
    }

    // Transactions
    match /transactions_nbb/{docId} {
      // Users can only read their own; admin can read all
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Notifications
    match /notifications/{docId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow create: if request.auth != null;
      allow update: if isAdmin() || (request.auth != null && resource.data.user_id == request.auth.uid);
      allow delete: if isAdmin();
    }

    // OTPs: allow users to read/write their own OTPs
    match /otps/{email} {
      allow read, write: if request.auth != null && request.auth.token.email == email;
    }

    // Account lookup: allows unauthenticated email lookup by account number for login
    match /account_lookup/{accountNumber} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email;
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['email', 'uid']);
      allow delete: if isAdmin();
    }
  }
}
